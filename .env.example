# ========================================================
# VARIABEL LINGKUNGAN LAPORMAGANG (VERCEL & SUPABASE)
# ========================================================

# 1. URL Domain Aplikasi (Vercel Production)
APP_URL="https://lapor-magang.vercel.app"

# 2. Provider AI (Google Gemini / AI Studio)
# Opsional jika kunci dimasukkan lewat Panel Admin (/admin)
GEMINI_API_KEY=""

# 3. Supabase (Database & Auth Cloud)
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# 4. Keamanan Webhook & Cron Job
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
CRON_SCHEDULER_SECRET=""

# 5. Payment Gateway (Midtrans) - Opsional jika menggunakan QRIS Manual Fattah Maulana
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"
